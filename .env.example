REDIS_URL=redis://:password@127.0.0.1:6379
NEXT_PUBLIC_APP_URL=https://selfdestruct.cloud

# Gates the private /admin/stats page (see proxy.ts and lib/adminAuth.ts).
# Unset in an environment, /admin is refused outright rather than left
# open. HTTP Basic Auth — any username, this password.
ADMIN_PASSWORD=

# Where the usage-counter durability backup is written (see
# lib/statsSnapshot.ts). Point this at a path on a persistent volume in
# production — without one, the file lives on the container's own
# ephemeral filesystem and won't survive a redeploy, only a Redis-only
# restart. Falls back to a local file for dev/test if unset.
STATS_SNAPSHOT_PATH=
